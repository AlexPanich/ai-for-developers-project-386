{
  "name": "my-monorepo",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:frontend": "bun --filter frontend dev",
    "dev:backend": "bun --filter backend dev",
    "dev": "bun --filter \"*\" dev",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "bun --filter \"*\" test",
    "test:frontend": "bun --filter frontend test",
    "test:backend": "bun --filter backend test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
